# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — SaaS Client (backend Spring Boot)
# Copier ce fichier en `.env` (ignore par git) OU definir ces variables dans
# l'environnement systeme. Toutes ont une valeur par defaut : l'application
# demarre sans aucune configuration (mode developpement).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de donnees ──
DB_USERNAME=root
DB_PASSWORD=

# ── JWT (obligatoire en production, >= 256 bits) ──
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-256-bits
JWT_EXPIRATION=86400000

# ── Email ──
# Laisser MAIL_DEV_MODE=true pour NE PAS envoyer d'email (code affiche en console).
# Pour un ENVOI REEL via Gmail :
#   1. Active la validation en 2 etapes sur ton compte Google.
#   2. Genere un "mot de passe d'application" (16 caracteres) :
#      https://myaccount.google.com/apppasswords
#   3. Renseigne les 3 variables ci-dessous puis relance le backend.
MAIL_DEV_MODE=true
MAIL_USERNAME=ton.adresse@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optionnel (defauts = Gmail) :
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_FROM=ton.adresse@gmail.com

# ── Assistant IA (optionnel) ──
# Sans cle, le moteur heuristique local repond (fallback). Avec une cle,
# les reponses sont generees par Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Divers ──
FRONTEND_URL=http://localhost:4200
