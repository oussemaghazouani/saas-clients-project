{
  "folders": [
    {
      "name": "Backend (Spring Boot)",
      "path": "brandwood-backend"
    },
    {
      "name": "Frontend (Angular)",
      "path": "brandwood-frontend"
    }
  ],
  "settings": {
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.eclipse.downloadSources": true,
    "java.maven.downloadSources": true,
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.encoding": "utf8",
    "typescript.preferences.quoteStyle": "single",
    "angular.enable-strict-mode-prompt": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.html, ${capture}.css, ${capture}.spec.ts",
      "pom.xml": ".mvn, mvnw, mvnw.cmd"
    },
    "[java]": {
      "editor.tabSize": 4
    },
    "[typescript]": {
      "editor.tabSize": 2
    },
    "[html]": {
      "editor.tabSize": 2
    }
  },
  "extensions": {
    "recommendations": [
      "vscjava.vscode-java-pack",
      "vmware.vscode-spring-boot",
      "angular.ng-template",
      "dbaeumer.vscode-eslint"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "▶ Backend: Spring Boot",
        "type": "shell",
        "command": "mvn spring-boot:run",
        "options": {
          "cwd": "${workspaceFolder:Backend (Spring Boot)}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "group": "saasclient"
        },
        "problemMatcher": []
      },
      {
        "label": "▶ Frontend: Angular Dev Server",
        "type": "shell",
        "command": "npm start",
        "options": {
          "cwd": "${workspaceFolder:Frontend (Angular)}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "group": "saasclient"
        },
        "problemMatcher": []
      },
      {
        "label": "▶▶ Démarrer Backend + Frontend",
        "dependsOn": ["▶ Backend: Spring Boot", "▶ Frontend: Angular Dev Server"],
        "dependsOrder": "parallel",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "🧪 Tests Maven",
        "type": "shell",
        "command": "mvn test",
        "options": {
          "cwd": "${workspaceFolder:Backend (Spring Boot)}"
        },
        "group": "test",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "🐛 Debug Spring Boot",
        "request": "launch",
        "mainClass": "com.saasclient.SaasClientApplication",
        "projectName": "saas-client",
        "vmArgs": "-Dspring.profiles.active=default"
      },
      {
        "type": "chrome",
        "name": "🐛 Debug Angular (Chrome)",
        "request": "launch",
        "url": "http://localhost:4200",
        "webRoot": "${workspaceFolder:Frontend (Angular)}/src"
      }
    ],
    "compounds": [
      {
        "name": "🚀 Full Stack Debug",
        "configurations": ["🐛 Debug Spring Boot", "🐛 Debug Angular (Chrome)"]
      }
    ]
  }
}
